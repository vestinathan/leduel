{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Visualisation Kepler.gl - Hackathon Mistral\n",
    "\n",
    "Carte interactive des salons de coiffure à Paris avec score de gap."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from keplergl import KeplerGl\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "# Charger les données\n",
    "data_dir = Path('..') / 'data' / 'processed'\n",
    "metrics_df = pd.read_csv(data_dir / 'scores_by_arrondissement.csv')\n",
    "salons_df = pd.read_csv(data_dir / 'salons_with_arrondissements.csv')\n",
    "\n",
    "# Nettoyer les salons\n",
    "cols_to_keep = ['name', 'address', 'lat', 'lng', 'rating', 'user_ratings_total', 'arrondissement']\n",
    "cols_to_keep = [c for c in cols_to_keep if c in salons_df.columns]\n",
    "salons_clean = salons_df[cols_to_keep].dropna(subset=['lat', 'lng']).rename(columns={'lat': 'latitude', 'lng': 'longitude'})\n",
    "\n",
    "# Créer la carte\n",
    "map_kepler = KeplerGl(height=800)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ajouter les salons\n",
    "map_kepler.add_data(data=salons_clean, name='Salons de Coiffure')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ajouter les arrondissements avec centroïdes\n",
    "arrondissements_centroides = {",
    "    1: [48.862563, 2.336443],   2: [48.868279, 2.342803],   3: [48.862872, 2.360001],\n",
    "    4: [48.854341, 2.357630],   5: [48.844443, 2.350715],   6: [48.849130, 2.332898],\n",
    "    7: [48.856174, 2.312188],   8: [48.872721, 2.312554],   9: [48.877164, 2.337458],\n",
    "    10: [48.876130, 2.360728],  11: [48.859059, 2.380058],  12: [48.834974, 2.421324],\n",
    "    13: [48.828388, 2.362270],  14: [48.829245, 2.326542],  15: [48.840085, 2.292826],\n",
    "    16: [48.860392, 2.261971],  17: [48.887327, 2.306777],  18: [48.892569, 2.348161],\n",
    "    19: [48.887076, 2.384821],  20: [48.863461, 2.401188],\n",
    "}\n",
    "\n",
    "# Créer DataFrame arrondissements\n",
    "arr_data = []\n",
    "for arr in range(1, 21):\n",
    "    if arr in metrics_df['arrondissement'].values:\n",
    "        arr_metrics = metrics_df[metrics_df['arrondissement'] == arr].iloc[0]\n",
    "        arr_data.append({\",
    "            'arrondissement': arr,\",
    "            'latitude': arrondissements_centroides[arr][0],\n",
    "            'longitude': arrondissements_centroides[arr][1],\n",
    "            'gap_score': arr_metrics['gap_score'],\",
    "            'population': arr_metrics['population'],\",
    "            'nb_salons': arr_metrics['nb_salons']\n",
    "        })\",
    "arrondissements_df = pd.DataFrame(arr_data)\
",
    "\n",
    "# Ajouter à la carte\n",
    "map_kepler.add_data(data=arrondissements_df, name='Arrondissements')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configurer les couches\n",
    "if 'Salons de Coiffure' in map_kepler.config:\n",
    "    map_kepler.config['Salons de Coiffure']['color'] = [255, 0, 0]\n",
    "    map_kepler.config['Salons de Coiffure']['radius'] = 200\n",
    "    map_kepler.config['Salons de Coiffure']['opacity'] = 0.8\n",
    "\n",
    "if 'Arrondissements' in map_kepler.config:\n",
    "    max_gap = arrondissements_df['gap_score'].max()\n",
    "    if max_gap > 0:\n",
    "        normalized = (arrondissements_df['gap_score'] / max_gap).tolist()\n",
    "    else:\n",
    "        normalized = [0.5] * len(arrondissements_df)\
",
    "    map_kepler.config['Arrondissements']['color'] = normalized\n",
    "    map_kepler.config['Arrondissements']['color_scale'] = 'RdYlBu_r'\n",
    "    map_kepler.config['Arrondissements']['radius'] = 500\n",
    "    map_kepler.config['Arrondissements']['opacity'] = 0.7"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Centrer sur Paris et afficher\n",
    "map_kepler.center_map = {'latitude': 48.8566, 'longitude': 2.3522, 'zoom': 12}\
",
    "map_kepler"
   ]
  }
 ],
